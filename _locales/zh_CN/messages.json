    "privacyOverview": { "message": "概述" },
    "privacyOverviewBody": { "message": "TimeDash 完全在您的浏览器中运行。它没有分析、遥测、广告或远程追踪。没有账户或服务器记录您的浏览历史。您的数据保留在您的设备上，并使用内置的浏览器存储 API 进行处理。" },
    "privacyDataStorage": { "message": "数据存储" },
    "privacyDataStorageBody1": { "message": "TimeDash 将您的偏好设置和历史记录保存在 Chrome 的本地存储 API 中（<code>chrome.storage.local</code>）。没有任何内容写入您的浏览器配置文件之外。扩展程序存储：" },
    "privacyDataStorageItem1": { "message": "时间追踪日志和按域名的历史记录" },
    "privacyDataStorageItem2": { "message": "每个网站的播放速度偏好设置" },
    "privacyDataStorageItem3": { "message": "网站屏蔽和每日限制规则" },
    "privacyDataStorageItem4": { "message": "主题和 UI 自定义选项" },
    "privacyDataStorageBody2": { "message": "这些数据仅用于显示您的使用统计和执行您的规则。没有任何部分发送到外部服务器。" },
    "privacyNetworkActivity": { "message": "网络活动" },
    "privacyNetworkActivityBody": { "message": "TimeDash 不进行任何出站网络调用。在开发者工具中看到的任何网络请求都来自您的浏览器解析网站图标或本地加载扩展资源。" },
    "privacyPermissions": { "message": "权限" },
    "privacyPermissionsBody": { "message": "TimeDash 仅请求追踪时间和执行规则所需的权限：" },
    "privacyPermissionStorage": { "message": "<code>storage</code>：在本地保存设置和历史记录。" },
    "privacyPermissionTabs": { "message": "<code>tabs</code>：读取活动标签页 URL 以记录时间和应用网站规则。" },
    "privacyPermissionScripting": { "message": "<code>scripting</code>：将视频速度控制注入到网页视频播放器中。" },
    "privacyPermissionWebNavigation": { "message": "<code>webNavigation</code>：跨框架跟踪 URL 导航。" },
    "privacyPermissionHost": { "message": "<code>host_permissions</code>：允许内容脚本在访问的网站上运行以追踪时间和管理视频播放。" },
    "privacyPermissionAlarms": { "message": "<code>alarms</code>：运行每日重置和可选的数据清除。" },
    "privacyPermissionNotifications": { "message": "<code>notifications</code>：（可选）当每日时间限制达到时提醒您。" },
    "privacyDataDeletion": { "message": "数据删除" },
    "privacyDataDeletionBody": { "message": "您拥有您的数据。您可以使用上面数据管理中的控件删除单个域名记录或清除所有数据。卸载 TimeDash 会自动从您的浏览器中删除所有存储的扩展数据。" },
    "privacyDataDeletionItem1": { "message": "点击<strong>删除所有数据</strong>立即清除每条记录。" },
    "privacyDataDeletionItem2": { "message": "开启<strong>自动清除旧数据</strong>自动清除较旧的记录。" },
    "privacyDataDeletionItem3": { "message": "使用<strong>删除特定数据</strong>搜索并删除单个域名的记录。" },
    "privacyNoAccount": { "message": "无需账户" },
    "privacyNoAccountBody": { "message": "TimeDash 不需要账户、电子邮件或云同步。所有数据都在您的设备上，由您控制。" },
    "privacyThirdParty": { "message": "第三方代码" },
    "privacyThirdPartyBody": { "message": "TimeDash 仅对开发工具使用开源库。分发的扩展程序不包含第三方追踪、分析或外部 SDK。" },
    "privacyLicense": { "message": "许可证" },
    "privacyLicenseBody": { "message": "TimeDash 在<strong>MIT 许可证</strong>下发布。您可以在许可条款下自由使用、修改和分享它。在 <a href=\"https://github.com/intelligent-username/TimeDash/blob/main/LICENSE\" target=\"_blank\" rel=\"noopener\">GitHub</a> 上查看源代码。" },
    "privacyContact": { "message": "联系和问题" },
    "privacyContactBody": { "message": "如果您发现错误或有隐私问题，请在 <a href=\"https://github.com/intelligent-username/TimeDash/issues\" target=\"_blank\" rel=\"noopener\">GitHub 问题页面</a>上打开问题，并提供描述和相关截图。" },
