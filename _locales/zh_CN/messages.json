    "helpTrackTimeBody": { "message": "时间追踪在 <button class=\"quick-link inline-link\" data-tab=\"general\">通用设置</button> 中启用后自动运行。打开弹出窗口查看今天的总计，或访问 <button class=\"quick-link inline-link\" data-tab=\"analytics\">分析</button> 查看图表和您的活动热图。" },
    "helpBlockSite": { "message": "…完全屏蔽一个网站？" },
    "helpBlockSiteBody": { "message": "转到 <button class=\"quick-link inline-link\" data-tab=\"blocking\">网站屏蔽</button>，输入域名，并将其添加为<strong>已屏蔽</strong>规则。每当您访问该域名时，扩展程序会将您重定向到屏蔽页面。" },
    "helpSetLimit": { "message": "…为网站设置每日时间限制？" },
    "helpSetLimitBody": { "message": "在 <button class=\"quick-link inline-link\" data-tab=\"blocking\">网站屏蔽</button> 中将域名添加为<strong>限制</strong>规则。设置以分钟为单位的时间限制。一旦当天超过限制，该网站将被屏蔽直到第二天。" },
    "helpChangeSpeed": { "message": "…更改视频播放速度？" },
    "helpChangeSpeedBody": { "message": "您可以通过以下方式之一更改播放速度：" },
    "helpChangeSpeedItem1": { "message": "使用您在视频控制选项卡中设置的键盘快捷键。（当前：<span id=\"helpCurrentShortcuts\"><code>+</code> / <code>-</code>，和 <code>.</code></span>）" },
    "helpChangeSpeedItem2": { "message": "点击扩展图标调出弹出窗口，在那里使用 <code>+</code> / <code>-</code>，和 <code>.</code> 按钮。" },
    "helpChangeSpeedItem3": { "message": "直接从视频控制选项卡更改速度。" },
    "helpCustomizeShortcuts": { "message": "…自定义键盘快捷键？" },
    "helpCustomizeShortcutsBody": { "message": "在 <button class=\"quick-link inline-link\" data-tab=\"video\">视频控制</button> 中配置快捷键。默认值是 <kbd>+</kbd> 提高速度，<kbd>-</kbd> 降低速度，<kbd>.</kbd> 重置。您还可以在 <code>chrome://extensions/shortcuts</code> 的扩展快捷键设置中设置 <kbd>Alt+T</kbd> 来切换追踪，<kbd>Alt+B</kbd> 来屏蔽当前网站。" },
    "helpChangeTheme": { "message": "…更改主题或强调色？" },
    "helpChangeThemeBody": { "message": "在 <button class=\"quick-link inline-link\" data-tab=\"general\">通用设置</button> 下，找到<strong>外观</strong>部分。选择浅色、深色或自动主题，并选择适合您设置的强调色。" },
    "helpExportData": { "message": "…导出或备份我的数据？" },
    "helpExportDataBody": { "message": "转到 <button class=\"quick-link inline-link\" data-tab=\"privacy\">隐私和数据</button>，使用<strong>导出数据</strong>按钮将您的使用情况和设置保存为 JSON 文件。稍后导入该文件以在其他配置文件上恢复您的数据，或在重新安装后恢复。" },
    "helpWhitelistDomain": { "message": "…将域名从追踪中移出白名单？" },
    "helpWhitelistDomainBody": { "message": "在 <button class=\"quick-link inline-link\" data-tab=\"privacy\">隐私和数据</button> 中将域名添加到白名单。在白名单网站上花费的时间不会被记录。" },
    "helpPauseTracking": { "message": "…暂时暂停追踪？" },
    "helpPauseTrackingBody": { "message": "在 <button class=\"quick-link inline-link\" data-tab=\"privacy\">隐私和数据</button> 中切换<strong>暂停追踪</strong>。暂停期间不会收集任何数据。" },
    "helpDeleteSpecific": { "message": "…删除特定网站的数据？" },
    "helpDeleteSpecificBody": { "message": "在 <button class=\"quick-link inline-link\" data-tab=\"privacy\">隐私和数据</button> 中使用<strong>搜索要删除数据的域名</strong>字段来查找和删除单个域名的记录。" },
    "helpMinutiae": { "message": "细节" },
    "helpPopupQuickActions": { "message": "弹出窗口快速操作" },
    "helpPopupQuickActionsBody": { "message": "打开弹出窗口查看今天的时间和热门网站。<kbd>Alt+T</kbd> 从任何页面切换追踪开关。<kbd>Alt+B</kbd> 立即屏蔽当前网站。" },
    "helpHeatmapDay": { "message": "点击任何热图日期" },
    "helpHeatmapDayBody": { "message": "点击日期单元格查看您访问了哪些网站以及多长时间。再次点击或按\"热门网站今天\"重置。" },
    "helpCustomAccent": { "message": "自定义强调色" },
    "helpCustomAccentBody": { "message": "在通用设置中，点击颜色选择器中的 <strong>+</strong> 添加任何十六进制颜色。" },
    "helpWatchStorage": { "message": "监控您的存储" },
    "helpWatchStorageBody": { "message": "隐私选项卡有存储计量器和自动清除设置，以防止旧数据堆积。" },
    "helpGettingHelp": { "message": "获取帮助" },
    "helpReportIssues": { "message": "报告问题和建议功能" },
    "helpReportIssuesBody1": { "message": "错误报告和功能请求转到 <a href=\"https://github.com/intelligent-username/TimeDash/issues\" target=\"_blank\" rel=\"noopener\">GitHub 问题页面</a>。" },
    "helpReportIssuesBody2": { "message": "报告错误时，包括：网站 URL、重现步骤、预期与实际行为，以及您的浏览器版本。当 UI 出现问题时，截图很有帮助。对于视频问题，请提及播放器是否嵌入在 iframe 中，并粘贴您在控制台中看到的任何错误。" },
    "helpReportIssuesBody3": { "message": "对于功能请求，您想要什么的简短描述以及原因就足以开始。" },
    "helpSourceCode": { "message": "源代码" },
    "helpSourceCodeBody": { "message": "完整源代码在 <a href=\"https://github.com/intelligent-username/TimeDash\" target=\"_blank\" rel=\"noopener\">github.com/intelligent-username/TimeDash</a>。如果您想审核扩展可以访问的内容，从 <code>manifest.json</code> 开始，然后读取后台脚本和内容脚本。" },
    "helpPrivacyQuestions": { "message": "隐私问题" },
    "helpPrivacyQuestionsBody": { "message": "在隐私和数据选项卡上阅读<a href=\"#\" id=\"privacyPolicyLink\">完整隐私政策</a>。如果某些内容与您在浏览器中看到的不匹配，请打开问题并提供详细信息。" },
