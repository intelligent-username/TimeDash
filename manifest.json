{
    "manifest_version": 3,
    "name": "TimeDash",
    "version": "1.3.6",
    "description": "Track time, block distractions, and control video speed. Private, local-only productivity analytics.",
    "default_locale": "en",
    "browser_specific_settings": {
        "gecko": {
            "id": "timedash@timedash.app",
            "strict_min_version": "109.0"
        }
    },
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "scripting",
        "webNavigation",
        "alarms",
        "notifications"
    ],
    "host_permissions": ["<all_urls>"],
    "incognito": "spanning",
    "background": {
        "service_worker": "background/background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "utils/domain-utils.js",
                "content/overlay.js",
                "content/modules/video-detector.js",
                "content/modules/video-controller.js",
                "content/modules/playback-state.js",
                "content/modules/message-handler.js",
                "content/modules/keyboard-handler.js",
                "content/content.js"
            ],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "TimeDash",
        "default_icon": {
            "16": "imgs/icon16.png",
            "32": "imgs/icon32.png",
            "48": "imgs/icon48.png",
            "128": "imgs/icon128.png"
        }
    },
    "options_page": "options/options.html",
    "icons": {
        "16": "imgs/icon16.png",
        "32": "imgs/icon32.png",
        "48": "imgs/icon48.png",
        "128": "imgs/icon128.png"
    },
    "commands": {
        "toggle-tracking": {
            "suggested_key": {
                "default": "Alt+T"
            },
            "description": "Toggle time tracking"
        },
        "toggle-block": {
            "suggested_key": {
                "default": "Alt+B"
            },
            "description": "Block/unblock current site"
        }
    },
    "web_accessible_resources": [
        {
            "resources": [
                "content/overlay.js",
                "block/block.html",
                "block/block.css",
                "block/comps/block-theme.css",
                "block/comps/block-components.css",
                "block/block.js",
                "block/modules/access.js",
                "block/modules/ui.js",
                "utils/storage/defaults.js",
                "utils/storage/settings.js",
                "utils/storage/usage.js",
                "utils/storage/blocking.js",
                "utils/storage/misc.js",
                "utils/storage.js"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}
